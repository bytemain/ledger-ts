{
  "name": "@hamsterbase/ledger-ts",
  "version": "0.14.0",
  "type": "module",
  "main": "dist/index.js",
  "repository": "git@github.com:hamsterbase/ledger-ts.git",
  "author": "monster <monster@hamsterbase.com>",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm",
    "cov": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "example:beancount": "tsx src/example/beancount.ts",
    "example:investment": "tsx src/example/investment.ts",
    "example:crypto": "tsx src/example/crypto.ts",
    "example:fava": "npm run example:fava:investment",
    "example:fava:investment": "npm run example:investment -- --output tmp/fava/investment.bean && python3 -m fava tmp/fava/investment.bean",
    "example:fava:crypto": "npm run example:crypto -- --output tmp/fava/crypto.bean && python3 -m fava tmp/fava/crypto.bean"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@vitest/coverage-v8": "^1.2.2",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.4.3",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {}
}
